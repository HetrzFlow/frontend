  },
  "peerDependencies": {
    "@hertzflow/sdk": "workspace:*",
    "@lingui/core": "^5.2.0",
    "@lingui/react": "^5.2.0",
    "@lingui/cli": "^5.2.0",
    "@lingui/conf": "^5.2.0",
    "next": "16.2.10",
    "tailwindcss": "^4.0.9",
    "@mysten/dapp-kit": "workspace:*",
    "@mysten/sui": "workspace:*",
