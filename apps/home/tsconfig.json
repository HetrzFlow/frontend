{
  "extends": "@repo/configs/typescript/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/locales/*": ["./locales/*"],
      "@/*": ["./src/*"],
      "@repo/common/locales/*": ["../../packages/common/locales/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
