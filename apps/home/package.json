{
  "name": "web-hub-home",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "lingui extract --clean && next dev --port 3001",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "lingui extract --clean && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hertzflow/sdk": "workspace:*",
    "@lingui/core": "^5.2.0",
    "@lingui/react": "^5.2.0",
    "@repo/common": "workspace:*",
    "@repo/i18n": "workspace:^",
    "@repo/lib": "workspace:*",
    "@repo/ui": "workspace:*",
    "animejs": "^4.1.3",
    "bignumber.js": "^9.1.2",
    "gsap": "^3.13.0",
    "lottie-web": "^5.13.0",
    "negotiator": "^1.0.0",
    "next": "16.2.10",
    "next-international": "^1.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "@lingui/cli": "^5.2.0",
    "@lingui/conf": "^5.2.0",
    "@lingui/loader": "^5.2.0",
    "@lingui/swc-plugin": "^5.4.0",
    "@repo/configs": "workspace:^",
    "@types/negotiator": "^0.6.3",
    "@vercel/microfrontends": "^2.3.2",
    "babel-plugin-react-compiler": "^1.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --config ./eslint.config.js",
    "*.{css,less,scss}": "stylelint --allow-empty-input --config ./stylelint.config.js"
  }
}
