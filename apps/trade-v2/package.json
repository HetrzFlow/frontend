{
  "name": "web-hub-trade-v2",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "lingui extract --clean && next dev --webpack --port 3002",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "lingui extract --clean && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "lint:css": "stylelint --config ./stylelint.config.js \"src/**/*.{css,less,scss}\"",
    "lint:css:fix": "stylelint --fix=lax --config ./stylelint.config.js \"src/**/*.{css,less,scss}\""
  },
  "dependencies": {
    "@hertzflow/sdk-v2": "workspace:*",
    "@hookform/resolvers": "^4.1.3",
    "@lingui/core": "^6.0.1",
    "@lingui/react": "^6.0.1",
    "@privy-io/react-auth": "3.37.0",
    "@repo/common": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/lib": "workspace:*",
    "@repo/ui": "workspace:*",
    "@stripe/crypto": "^1.1.1",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/microfrontends": "^2.3.2",
    "@vercel/og": "^0.11.1",
    "bignumber.js": "^9.1.2",
    "d3-sankey": "^0.12.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "html-to-image": "^1.11.13",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.54.2",
    "react-slot-counter": "^3.3.2",
    "react-window": "^2.2.3",
    "recharts": "3.0.2",
    "tailwindcss": "^4.0.9",
    "viem": "2.50.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@lingui/cli": "^6.0.1",
    "@lingui/conf": "^6.0.1",
    "@lingui/loader": "^6.0.1",
    "@lingui/swc-plugin": "^6.0.0",
    "@repo/configs": "workspace:^",
    "@types/d3-sankey": "^0.12.5",
    "@types/negotiator": "^0.6.3",
    "@types/qrcode": "^1.5.6",
    "babel-plugin-react-compiler": "^1.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --config ./eslint.config.js",
    "*.{css,less,scss}": "stylelint --fix=lax --allow-empty-input --config ./stylelint.config.js"
  }
}
