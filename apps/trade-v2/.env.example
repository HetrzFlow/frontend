# Hosts used by server-side routing.
# MAINNET_HOST should point to the standalone Genesis domain while Season 1 is active.
MAINNET_HOST=early.hertzflow.xyz
# Client-visible destinations used by Settings > Network.
NEXT_PUBLIC_TESTNET_HOST=https://testnet.hertzflow.xyz
NEXT_PUBLIC_MAINNET_HOST=https://www.hertzflow.xyz
REDIRECT_MAINTENANCE=false
MAINTENANCE_URL=http://localhost:3003

# Deploy this app as the standalone Genesis site.
GENESIS_STANDALONE=false
# Set true for the existing web-hub-trade-v2 mainnet project. Keep false for
# the standalone web-hub-trade-v2-testnet project.
MICROFRONTENDS_ENABLED=false
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GENESIS_URL=https://early.hertzflow.xyz
# Show the Journey to 50M entry in the regular site's desktop and mobile Header.
NEXT_PUBLIC_SHOW_GENESIS_ENTRY=false

# api url
NEXT_PUBLIC_KLINE_API_URL=
# ws url
NEXT_PUBLIC_WS_URL=

NEXT_PUBLIC_HOME_URL=https://hz-test.vercel.app


# BNB Smart Chain data and oracle services.
NEXT_PUBLIC_API_URL_BSC=
NEXT_PUBLIC_ORACLE_API_URL_BSC=
# HertzFlow supports BNB Smart Chain mainnet (56) and testnet (97).
# The example defaults to BSC testnet for local development.
NEXT_PUBLIC_FORCE_CHAIN_ID=97
# Optional private BNB Chain WebSocket RPC URLs. Keep real values out of source
# control. Because these are client-side variables, deployed values remain
# visible to browser users.
NEXT_PUBLIC_ENABLE_PRIVATE_RPC=false
NEXT_PUBLIC_BNB_MAINNET_RPC_WS=
NEXT_PUBLIC_BNB_TESTNET_RPC_WS=
NEXT_PUBLIC_ENABLE_SWAP=true
# Show the Merits page and navigation entry only when explicitly enabled.
NEXT_PUBLIC_ENABLE_MERITS=false
# Show LP pending orders. Defaults to true; set to false to hide them.
NEXT_PUBLIC_SHOW_LP_PENDING_ORDERS=true

NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
