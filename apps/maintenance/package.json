{
  "name": "@hertzflow/maintenance",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "lingui extract --clean && next dev --port 3003",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "lingui extract --clean && NODE_ENV=production next build --webpack",
    "start": "next start --port 3003",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@lingui/core": "^5.2.0",
    "@lingui/react": "^5.2.0",
    "@repo/common": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/lib": "workspace:*",
    "@repo/ui": "workspace:*",
    "negotiator": "^1.0.0",
    "next": "16.2.10",
    "next-international": "^1.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-responsive": "^10.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "@lingui/cli": "^5.2.0",
    "@lingui/conf": "^5.2.0",
    "@lingui/loader": "^5.2.0",
    "@lingui/swc-plugin": "^5.4.0",
    "@repo/configs": "workspace:^",
    "@types/negotiator": "^0.6.3",
    "babel-plugin-react-compiler": "^1.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --config ./eslint.config.js",
    "*.{css,less,scss}": "stylelint --allow-empty-input --config ./stylelint.config.js"
  }
}
